{
  "description": "Provide KataKit technical communication conventions to sessions and subagents",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/inject-communication-standard.mjs"],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/inject-communication-standard.mjs"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
